CATTS_API_KEY=
# blank = no auth; set catts-local (or any string) so CatReader has a value to send as X-API-Key
CATTS_API_PORT=59200
# Slack Incoming Webhook → alert when API falls (npm run watch:slack). Not Cursor @cursor.
CATTS_SLACK_WEBHOOK_URL=
CATTS_WORKER_URL=
# Legacy: unlimited | none (prefer FAST/BATCH below)
CATTS_OCR_ENGINE=none
# Fast = read-this-page-now (tesseract). Batch = books (omniroute | unlimited | tesseract).
CATTS_OCR_FAST=tesseract
CATTS_OCR_BATCH=omniroute
# Optional vision polish after fast Tesseract (1=on)
CATTS_OCR_FAST_POLISH=
CATTS_OMNIROUTE_URL=http://127.0.0.1:20128/v1
CATTS_OMNIROUTE_API_KEY=
CATTS_OMNIROUTE_VISION_MODEL=openrouter/free
CATTS_TTS_ENGINE=pocket
# Books: pocket (CPU overnight). Edge banned for albums unless CATTS_ALLOW_EDGE_BOOKS=1.
# Live alt: kokoro | melotts | chatterbox (clone, ~8GB free RAM)
# Lean book queue: leave API up; STT off unless you need mic (1=warm Whisper on boot)
CATTS_STT_WARMUP=

# Default TTS: kokoro | melotts (Spanish only) | edge | fish | xtts | pocket | chatterbox | gptsovits
# Runtime override (no restart): PUT /tts/engine {"engine":"fish"} or UI Live dropdown (v0.7.3+)
CATTS_KOKORO_URL=http://127.0.0.1:8880
CATTS_KOKORO_VOICE=af_bella
CATTS_KOKORO_VOICE_ES=ef_dora
# Legacy opt-in only. Leave blank to keep Spanish on native Kokoro.
CATTS_PIPER_URL=
# Optional: pin your voice id (else first ready voice is used)
CATTS_DEFAULT_VOICE_ID=
# Fish books: MUST lock one ref wav or each chunk gets a random speaker (disaster).
# Prefer data/voices/<id>/fish_ref_en_15s.wav — see docs/FISH_VOICE_LOCK.md
CATTS_FISH_URL=http://127.0.0.1:8080
CATTS_FISH_REF_EN=
CATTS_FISH_REF_ES=
CATTS_TTS_SPEED=0.9
CATTS_TTS_CHUNK_MIN=400
CATTS_TTS_CHUNK_MAX=800
# Set to 1 only after accepting Coqui XTTS v2 CPML/commercial terms.
CATTS_ACCEPT_COQUI_CPML=

# Text translation engine (offline)
# - auto: use Madlad400 if model is present, otherwise Argos
# - argos: Argos offline EN<->ES
# - madlad: google/madlad400-3b-mt offline
CATTS_TRANSLATE_ENGINE=auto

# Madlad400 offline model folder (download once into this path)
CATTS_MADLAD_MODEL_ID=google/madlad400-3b-mt
CATTS_MADLAD_MODEL_DIR=
CATTS_MADLAD_NUM_BEAMS=4
CATTS_MADLAD_MAX_NEW_TOKENS=256
CATTS_MADLAD_SPLIT_SENTENCES=1
