CATTS_API_KEY=
CATTS_API_PORT=59200
CATTS_WORKER_URL=
CATTS_OCR_ENGINE=none
CATTS_TTS_ENGINE=fish
# TTS engine: fish | xtts | kokoro | pocket | edge | chatterbox | gptsovits
# fish = Fish Speech via ZLUDA on AMD (RX 6600). See docs/FISH_ZLUDA_RX6600.md
CATTS_FISH_URL=http://127.0.0.1:8080
CATTS_FISH_ROOT=
# Speak rate: 0.9 = ~10% slower (default). 1.0 = normal. Range 0.5–2.0.
CATTS_TTS_SPEED=0.9
CATTS_KOKORO_URL=http://127.0.0.1:8880
CATTS_KOKORO_VOICE=af_bella
# Optional: pin your voice id (else first ready voice is used)
CATTS_DEFAULT_VOICE_ID=
# Set to 1 only after accepting Coqui XTTS v2 CPML/commercial terms.
CATTS_ACCEPT_COQUI_CPML=
